{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfguard.dev/schemas/result.v1.json",
  "title": "PerfGuard Run Result",
  "description": "Schema for perfguard run result.json output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "side",
    "created_at",
    "git",
    "env",
    "params",
    "benchmarks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "type": "string",
      "enum": ["base", "head"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref", "dirty"],
      "properties": {
        "sha": { "type": "string" },
        "ref": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "go_version", "num_cpu", "cpu_model", "gomaxprocs"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "go_version": { "type": "string" },
        "num_cpu": { "type": "integer", "minimum": 1 },
        "cpu_model": { "type": "string" },
        "gomaxprocs": { "type": "integer", "minimum": 1 },
        "hostname": { "type": "string" },
        "kernel_version": { "type": "string" },
        "extra": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "benchtime",
        "cpu",
        "include",
        "mode",
        "warmup_runs",
        "max_extra_runs",
        "extra_round_step"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "benchtime": { "type": "string" },
        "cpu": { "type": "integer", "minimum": 0 },
        "include": { "type": "string" },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mode": { "type": "string" },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "max_extra_runs": { "type": "integer", "minimum": 0 },
        "extra_round_step": { "type": "integer", "minimum": 1 },
        "extra_runs": { "type": "integer", "minimum": 0 }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "name", "procs", "samples"],
        "properties": {
          "package": { "type": "string" },
          "name": { "type": "string" },
          "procs": { "type": "integer", "minimum": 0 },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["iterations", "values"],
              "properties": {
                "iterations": { "type": "integer", "minimum": 0 },
                "values": {
                  "type": "object",
                  "additionalProperties": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmark", "type", "path", "runs"],
        "properties": {
          "benchmark": { "type": "string" },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "runs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
